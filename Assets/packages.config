<?xml version="1.0" encoding="utf-8"?>
<packages>
  <!--
    Official Anthropic .NET SDK plus its full transitive closure, committed
    directly under Assets/Packages/ (netstandard2.0 builds, Unity-loadable).
    Everything is present on the branch, so no NuGet restore is required — a
    plain `git pull` gives you the whole set. The shim assemblies the SDK also
    lists (System.Memory, System.Buffers, System.Runtime.CompilerServices.Unsafe,
    System.Threading.Tasks.Extensions, System.Numerics.Vectors) are deliberately
    NOT included: Unity 6's .NET Standard 2.1 profile already provides them, and
    adding the NuGet copies would collide (duplicate types).
  -->
  <package id="Anthropic" version="12.36.0" manuallyInstalled="true" />
  <package id="Microsoft.Bcl.AsyncInterfaces" version="10.0.6" />
  <package id="Microsoft.Extensions.AI.Abstractions" version="10.5.1" />
  <package id="System.Collections.Immutable" version="8.0.0" />
  <package id="System.IO.Pipelines" version="10.0.6" />
  <package id="System.Net.ServerSentEvents" version="10.0.1" />
  <package id="System.Text.Encodings.Web" version="10.0.6" />
  <package id="System.Text.Json" version="10.0.6" />
</packages>
